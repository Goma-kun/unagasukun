      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unagasukun"
          }
        }
      }
    },
    "お知らせ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders"
          }
        }
      }
    },
