          }
        }
      }
    },
    "ちゃんと続いています。すばらしい！": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re keeping it up. Wonderful!"
          }
        }
      }
    },
    "できた": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
