    "iCloud で揃える": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync with iCloud"
          }
        }
      }
    },
    "iCloud にサインインすると、ほかの端末と揃います": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to sync with your other devices"
          }
        }
      }
    },
    "iCloud に接続できませんでした": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect to iCloud"
          }
        }
      }
    },
    "iCloud の状態が分かりませんでした": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check iCloud status"
          }
        }
      }
    },
    "→ %@ に1回だけ。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Once on %@. "
          }
        }
      }
    },
    "→ %@ に繰り返します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Repeats: %@. "
          }
        }
      }
    },
    "→ %@ の%lld日に、1回ずつ。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Once on each of these %2$lld days: %1$@. "
          }
        }
      }
    },
    "→ %@。%@ と続きます。「できた」を押した日から数え直します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ %1$@. Next: %2$@, and so on. Counting restarts from the day you tap Done. "
          }
        }
      }
    },
    "→ 日付を選んでください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Choose a date."
          }
        }
      }
    },
    "→ 曜日を選んでください。毎日なら全部押します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Choose weekdays. Tap all of them for every day."
          }
        }
      }
    },
    "◯日ごと": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every N days"
          }
        }
      }
    },
    "「%@」の時間が終わりました。できましたか？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has ended. Did you get it done?"
