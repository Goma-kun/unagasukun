  "strings": {
    " ほか": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and more"
          }
        }
      }
    },
    "%@ にお知らせします。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you at %@. "
          }
        }
      }
    },
    "%@ にできたと記録しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked as done on %@"
          }
        }
      }
    },
    "%@ にできたと記録しました。次の目安日は %@ です": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked as done on %1$@. Next due date: %2$@"
          }
        }
      }
    },
    "%@ にできたと記録しました。次の目安日は %@ なので、今日の予定に残ります": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked as done on %1$@. Next due date is %2$@, so it stays in today’s list"
          }
        }
      }
    },
    "%@ にできたと記録しました。目安日（%@）が来ているので、今日の予定に残ります": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked as done on %1$@. The due date (%2$@) has come, so it stays in today’s list"
          }
        }
      }
    },
    "%@ の予定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans for %@"
          }
        }
      }
    },
