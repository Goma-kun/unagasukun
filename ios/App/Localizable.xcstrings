          "stringUnit": {
            "state": "translated",
            "value": "Yesterday (%@)"
          }
        }
      }
    },
    "ここには、できた日が色で並びます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days you got things done will show up here in color."
          }
