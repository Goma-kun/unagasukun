      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History (13 weeks through this week)"
          }
        }
      }
    },
    "しばらく休む": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause for a while"
          }
        }
      }
    },
