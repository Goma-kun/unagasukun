      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@–%@"
          }
        }
      }
    },
    "%@〜%@ の時間帯。始まりと終わりにお知らせします。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time slot %1$@–%2$@. Reminds you at the start and the end. "
