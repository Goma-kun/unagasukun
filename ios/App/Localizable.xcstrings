      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming"
          }
        }
      }
    },
    "これまでの記録は残ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past records will be kept."
          }
        }
      }
    },
